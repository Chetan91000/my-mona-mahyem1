---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Mona Mayhem</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<main class="battle-page" data-theme="classic">
			<button class="theme-toggle" id="theme-toggle" type="button">
				Switch to Blue/Orange Theme
			</button>
			<h1>Mona Mayhem</h1>
			<p class="subtitle">GitHub Contribution Battle Arena</p>
			<section class="battle-grid">
				<article class="fighter-card">
					<h2>Player One</h2>
					<p>@octocat</p>
				</article>
				<div class="vs-badge" aria-label="versus">VS</div>
				<article class="fighter-card">
					<h2>Player Two</h2>
					<p>@hubot</p>
				</article>
			</section>
		</main>
		<script>
			const battlePage = document.querySelector(".battle-page");
			const toggle = document.querySelector("#theme-toggle");
			if (battlePage && toggle) {
				toggle.addEventListener("click", () => {
					const nextTheme = battlePage.dataset.theme === "classic" ? "alt" : "classic";
					battlePage.dataset.theme = nextTheme;
					toggle.textContent =
						nextTheme === "alt"
							? "Switch to Classic Theme"
							: "Switch to Blue/Orange Theme";
				});
			}
		</script>
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		min-height: 100vh;
		background: #0a0a1a;
		display: grid;
		place-items: center;
		padding: 2rem;
	}

	.battle-page {
		--accent-primary: #5fed83;
		--accent-secondary: #8a2be2;
		--bg-panel: rgba(8, 8, 34, 0.85);
		--text-color: #f6f6ff;
		font-family: "Press Start 2P", system-ui;
		color: var(--text-color);
		width: min(960px, 100%);
		padding: 2rem;
		border: 3px solid var(--accent-primary);
		box-shadow:
			0 0 12px var(--accent-primary),
			0 0 20px color-mix(in srgb, var(--accent-secondary) 60%, transparent);
		background:
			repeating-linear-gradient(
				0deg,
				rgba(255, 255, 255, 0.04) 0,
				rgba(255, 255, 255, 0.04) 1px,
				transparent 1px,
				transparent 5px
			),
			#0a0a1a;
		text-align: center;
	}

	.battle-page[data-theme="alt"] {
		--accent-primary: #00f5ff;
		--accent-secondary: #ff6b35;
	}

	.theme-toggle {
		font: inherit;
		padding: 0.75rem 1rem;
		border: 2px solid var(--accent-secondary);
		background: transparent;
		color: var(--accent-secondary);
		cursor: pointer;
		margin-bottom: 1.5rem;
	}

	h1 {
		color: var(--accent-primary);
		text-shadow: 0 0 10px var(--accent-primary);
		font-size: clamp(1.5rem, 4vw, 2.25rem);
		margin: 0;
	}

	.subtitle {
		color: var(--accent-secondary);
		margin: 1.25rem 0 2rem;
	}

	.battle-grid {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 1rem;
		align-items: center;
	}

	.fighter-card {
		padding: 1.25rem;
		border: 2px solid var(--accent-primary);
		background: var(--bg-panel);
		box-shadow: 0 0 10px color-mix(in srgb, var(--accent-primary) 65%, transparent);
	}

	.vs-badge {
		color: #0a0a1a;
		background: linear-gradient(45deg, var(--accent-primary), var(--accent-secondary));
		padding: 1rem;
		border-radius: 999px;
	}

	@media (max-width: 800px) {
		.battle-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
